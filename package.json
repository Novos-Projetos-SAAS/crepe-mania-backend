{
  "name": "crepe-mania-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API de pedidos, delivery e administracao da Crepe Mania",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "knex migrate:latest --knexfile knexfile.js",
    "db:migrate:status": "knex migrate:list --knexfile knexfile.js",
    "db:rollback": "knex migrate:rollback --knexfile knexfile.js",
    "db:seed": "node src/database/seeds/runSeeds.js",
    "db:seed:status": "node src/database/seeds/seedStatus.js",
    "push:keys": "node scripts/gerarChavesVapid.js",
    "maintenance:dry-run": "node scripts/manutencao.js",
    "maintenance:execute": "node scripts/manutencao.js --execute",
    "test": "vitest run --exclude tests/integration/**",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --config vitest.integration.config.js",
    "test:coverage": "vitest run tests/unit --coverage",
    "test:coverage:integration": "vitest run tests/integration --coverage --config vitest.integration.config.js",
    "lint": "eslint .",
    "check": "npm run lint && npm run test:unit",
    "db:deploy": "npm run db:migrate && npm run db:seed",
    "check:source": "node scripts/verifyFreshInstall.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "luxon": "^3.7.2",
    "multer": "^2.5.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "globals": "^16.4.0",
    "nodemon": "^3.1.10",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "vitest": "^4.0.4"
  }
}
