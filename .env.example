# Ambiente/API
NODE_ENV=development
PORT=3333
APP_PUBLIC_URL=
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=0
BODY_LIMIT=256kb
LOG_LEVEL=info
TZ=America/Sao_Paulo

# Neon/PostgreSQL (obrigatorio para requests que acessam dados; preencher na segunda etapa)
DATABASE_URL=
DATABASE_TEST_URL=
RUN_DB_INTEGRATION=false
# Unica variavel nova para InfinitePay; Base64 canonico de 32 bytes, exclusiva da integracao.
# Deixe vazia enquanto desabilitada. API Key e URLs sao configuradas no banco pelo painel/API admin.
INFINITEPAY_ENCRYPTION_KEY=
DB_SSL_MODE=require
DB_SSL_CA=
DB_POOL_MIN=0
DB_POOL_MAX=10

# Sessao/autenticacao (JWT_SECRET obrigatorio em producao e nos seeds)
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
INVITE_EXPIRATION_HOURS=48
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# Seed inicial admin (senha: minimo 12, com minuscula, maiuscula e numero; usado somente nos seeds)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Web Push opcional
PUSH_ENABLED=false
# Base64 canonico de exatamente 32 bytes (independente de JWT_SECRET)
PUSH_ENCRYPTION_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_POLL_INTERVAL_MS=15000
PUSH_MAX_ATTEMPTS=5
SOCKET_REVALIDATE_MS=60000

# Upload de imagens Cloudflare R2 opcional
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
IMAGE_UPLOAD_MAX_BYTES=5242880
IMAGE_UPLOAD_MAX_PIXELS=40000000

# Impressao opcional
PRINT_AGENT_TOKEN=
PRINT_LEASE_SECONDS=60
PRINT_MAX_ATTEMPTS=5
PRINT_PAIRING_TTL_MINUTES=10
PRINT_DEVICE_TOKEN_TTL_DAYS=180
PRINT_RETRY_BASE_SECONDS=15
QZ_ENABLED=false
QZ_PRIVATE_KEY=
QZ_CERTIFICATE=
